# Loaded automatically by Vite during `npm run build` (Vercel's build step).
# Committed on purpose so the production backend URL is baked into the static
# bundle. Override per-deployment by setting VITE_API_BASE in the Vercel
# project's Environment Variables (Production scope) — dashboard values win.
VITE_API_BASE=https://khata-app-backend-beta.vercel.app/api/v1
